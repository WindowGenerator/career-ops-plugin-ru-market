--- a/providers/local-parser.mjs
+++ b/providers/local-parser.mjs
@@ -205,6 +205,16 @@ function normalizeParserJob(job, entry) {
   );
   if (postedAt !== undefined) out.postedAt = postedAt;
 
+  for (const key of ['description', 'note']) {
+    if (typeof job[key] === 'string' && job[key].trim()) out[key] = job[key].trim();
+  }
+  const salary = job.salary;
+  if (salary && typeof salary === 'object' && /^[A-Z]{3}$/.test(salary.currency ?? '')) {
+    const bounds = ['from', 'to'].filter(key => typeof salary[key] === 'number' && Number.isFinite(salary[key]) && salary[key] >= 0);
+    if (bounds.length && !(bounds.length === 2 && salary.from > salary.to)) {
+      out.salary = Object.fromEntries([['currency', salary.currency], ...bounds.map(key => [key, salary[key]])]);
+    }
+  }
   return out;
 }
 
